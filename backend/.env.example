# NutriLens Backend — Environment Variables
# Copy this file to .env and fill in real values before running.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-something-random-and-long
DATABASE_URL=mysql+pymysql://nutrilens:nutrilens_password@localhost:3306/nutrilens_db

# SQLite alternative for local dev (no MySQL needed):
# DATABASE_URL=sqlite:///nutrilens_dev.db

# --- Hosted MySQL SSL (e.g., Aiven) ---
# DB_SSL_CA=/path/to/ca.pem

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-also-random

# --- CORS ---
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Set to true only in development when opening index.html directly from disk (null origin)
CORS_ALLOW_NULL_ORIGIN=false

# --- Open Food Facts & Barcode Lookup ---
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=NutriLens/0.1 (user@nutrilens.app)
OFF_TIMEOUT_S=5
OFF_CACHE_TTL_DAYS=30

# --- Testing ---
# TEST_DATABASE_URL=sqlite:///:memory:
